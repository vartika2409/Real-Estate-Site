# ============================================================
# LuxEstate — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.
# ============================================================

# Supabase project URL — found in Supabase Dashboard → Settings → API
# Used by: src/lib/supabase.ts, src/components/auth/SignInModal.tsx, scripts/seed.mjs
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous public key — found in Supabase Dashboard → Settings → API
# Safe to expose in the browser. Controls access via Row Level Security (RLS).
# Used by: src/lib/supabase.ts, src/components/auth/SignInModal.tsx, scripts/seed.mjs
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
